{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
, "app/page.jsx", "app/properties/[id]/page.jsx", "app/add-property/page.jsx", "app/dashboard/page.jsx", "app/login/page.jsx", "app/register/page.jsx", "components/EditProfile.jsx", "components/Footer.jsx", "components/InquiriesList.jsx", "components/InquiryModal.jsx", "components/MyProperties.jsx", "components/PropertyCard.jsx", "components/Navbar.jsx", "components/ProtectedLayout.jsx"  ],
  "exclude": ["node_modules"]
}

